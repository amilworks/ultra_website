---
import PostCard from "@/components/PostCard.astro";
import SiteShell from "@/layouts/SiteShell.astro";
import { getAllNews } from "@/lib/content";

const news = await getAllNews();
---

<SiteShell
  title="BisQue Ultra Product News | Launch, Platform, and Interface Updates"
  description="Read the BisQue Ultra launch brief, platform foundation, and interface update for the scientific AI workbench over BisQue resources and durable runs."
  canonicalPath="/news"
  image="/images/news/bisque-ultra-launch2.png"
>
  <section class="section-block">
    <div class="section-header">
      <p class="eyebrow">Product news</p>
      <h1 class="section-title">Read the launch, the platform proof, and the interface update.</h1>
      <p class="section-lead">
        Start with the updated BisQue Ultra launch brief, then read the pieces that explain the scientific
        substrate and the product surface. The sequence is written for labs that need to know what runs,
        what persists, and what evidence stays attached.
      </p>
    </div>
    <div class="post-grid">
      {news.map((entry) => (
        <PostCard
          href={`/news/${entry.data.slug}`}
          title={entry.data.title}
          excerpt={entry.data.excerpt}
          date={entry.data.date}
          kind={entry.data.kind}
          sequence={entry.data.sequence}
        />
      ))}
    </div>
  </section>
</SiteShell>
