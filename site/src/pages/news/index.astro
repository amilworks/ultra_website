---
import PostCard from "@/components/PostCard.astro";
import SiteShell from "@/layouts/SiteShell.astro";
import { getAllNews } from "@/lib/content";

const news = await getAllNews();
---

<SiteShell
  title="BisQue Ultra Research and Engineering Notes"
  description="Read the BisQue Ultra 2026.07 release, scientific imaging architecture, model lifecycle, materials evidence, BisQue foundation, and interface design notes."
  canonicalPath="/news"
  image="/images/news/bisque-ultra-launch2.png"
>
  <section class="section-block">
    <div class="section-header">
      <p class="eyebrow">Product news</p>
      <h1 class="section-title">Read the release through the systems that make it credible.</h1>
      <p class="section-lead">
        Start with the 2026.07 launch brief, then go deeper on scientific imaging, gated model
        operations, materials evidence, the BisQue platform, and the interface. Each note distinguishes
        what the product does now, why it was built that way, and where a research boundary remains.
      </p>
    </div>
    <div class="post-grid">
      {news.map((entry) => (
        <PostCard
          href={`/news/${entry.data.slug}`}
          title={entry.data.title}
          excerpt={entry.data.excerpt}
          date={entry.data.date}
          kind={entry.data.kind}
          sequence={entry.data.sequence}
        />
      ))}
    </div>
  </section>
</SiteShell>
