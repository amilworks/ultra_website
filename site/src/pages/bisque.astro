---
import SiteShell from "@/layouts/SiteShell.astro";
import { siteConfig } from "@/data/site";
import { bisqueCapabilities, researchPrograms, sourceLinks } from "@/data/research";

const baseUrl = import.meta.env.BASE_URL;
const toHref = (href: string) =>
  href.startsWith("/") ? `${baseUrl}${href.replace(/^\//, "")}` : href;
const canonicalUrl = Astro.site ? new URL(toHref("/bisque"), Astro.site).toString() : undefined;
const bisqueJsonLd = canonicalUrl
  ? {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: "BisQue",
      applicationCategory: "Scientific image informatics platform",
      operatingSystem: "Web",
      url: canonicalUrl,
      codeRepository: sourceLinks.bisqueRepo,
      creator: {
        "@type": "Organization",
        name: "UCSB Vision Research Lab",
        url: siteConfig.vrlUrl,
      },
      description:
        "BisQue is a web-based platform for scientific image storage, metadata, annotation, visualization, and analysis modules across multimodal research domains.",
      sameAs: [siteConfig.platformUrl, siteConfig.docsUrl, sourceLinks.researchOutreach],
    }
  : undefined;
---

<SiteShell
  title="BisQue | Scientific Image Informatics Platform"
  description="BisQue unifies 5D scientific images, metadata, annotations, visualization, scalable analysis modules, and reproducible computer vision workflows."
  canonicalPath="/bisque"
  image="/images/bisque/workshop/store-share-collaborate.png"
  imageAlt="BisQue workshop slide showing the platform as a place to store, share, and collaborate on scientific images."
  jsonLd={bisqueJsonLd}
>
  <div class="home-editorial lab-home bisque-page">
    <section class="lab-hero bisque-hero section-block" aria-label="BisQue overview">
      <div class="bisque-hero-grid">
        <div class="section-header lab-hero-copy">
          <h1 class="lab-headline">BisQue</h1>
          <p class="lab-affiliation">Scientific image informatics for reproducible computer vision.</p>
          <p class="lab-subhead">
            BisQue is the lab’s scientific image platform: a browser-based environment for storing,
            searching, annotating, visualizing, and analyzing scientific images with extensible
            modules and flexible metadata.
          </p>
          <div class="launch-command-line lab-command-line" aria-label="BisQue capabilities">
            <span>5D image data</span>
            <span>Flexible metadata</span>
            <span>Analysis modules</span>
            <span>Browser visualization</span>
          </div>
          <div class="hero-actions launch-actions">
            <a class="primary-button" href={siteConfig.platformUrl} target="_blank" rel="noreferrer">
              Open BisQue
            </a>
            <a class="secondary-button" href={siteConfig.docsUrl} target="_blank" rel="noreferrer">
              Read docs
            </a>
            <a class="secondary-button" href={sourceLinks.bisqueRepo} target="_blank" rel="noreferrer">
              View repository
            </a>
          </div>
        </div>
        <aside class="bisque-hero-visual">
          <figure class="bisque-workshop-frame">
            <img
              src={toHref("/images/bisque/workshop/store-share-collaborate-800.webp")}
              srcset={`${toHref("/images/bisque/workshop/store-share-collaborate-800.webp")} 800w, ${toHref("/images/bisque/workshop/store-share-collaborate-1400.webp")} 1400w`}
              sizes="(max-width: 820px) calc(100vw - 28px), 50vw"
              width="1400"
              height="788"
              alt="BisQue workshop slide showing store, share, and collaborate next to the BisQue browser interface."
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            <figcaption>
              Workshop framing: BisQue is a browser workspace for storing, sharing, and collaborating
              around scientific image resources.
            </figcaption>
          </figure>
          <div class="bisque-context-panel">
            <p class="eyebrow">Research objective</p>
            <p>
              Research Outreach describes BisQue as an advanced image database and analysis system for
              large-scale image databases, flexible experimental data management, metadata and
              content-based search, analysis integration, and knowledge discovery.
            </p>
            <a href={sourceLinks.researchOutreach} target="_blank" rel="noreferrer">
              Read the reproducible computer vision article
            </a>
          </div>
        </aside>
      </div>

      <div class="proof-strip lab-proof research-proof" aria-label="BisQue proof points">
        <article class="proof-item">
          <p class="eyebrow">Data model</p>
          <p class="proof-item-title">Images, annotations, metadata, and analysis stay together.</p>
          <p class="proof-item-body">
            The platform is designed for scientific datasets where raw pixels are only one part of
            the research record.
          </p>
        </article>
        <article class="proof-item">
          <p class="eyebrow">Scale</p>
          <p class="proof-item-title">Large 5D image data can be handled through web infrastructure.</p>
          <p class="proof-item-body">
            The public repository describes PB-scale image management, millions of annotations, and
            large image processing.
          </p>
        </article>
        <article class="proof-item">
          <p class="eyebrow">Translation</p>
          <p class="proof-item-title">New methods can move from paper to shared analysis module.</p>
          <p class="proof-item-body">
            BisQue gives domain researchers access to machine-learning tools without requiring them
            to rebuild the computational stack.
          </p>
        </article>
      </div>
    </section>

    <section class="bisque-workshop section-block" aria-label="BisQue workshop evidence">
      <div class="section-header research-section-heading">
        <p class="eyebrow">Workshop evidence</p>
        <h2 class="section-title">BisQue turns scientific image work into browser-visible infrastructure.</h2>
        <p class="section-lead">
          The Winter 2025 workshop material makes the product story concrete: large mosaics,
          multidimensional viewers, containerized workflows, and module outputs can sit inside one
          shared image-informatics workspace.
        </p>
      </div>
      <div class="bisque-workshop-grid">
        <article class="bisque-workshop-card bisque-workshop-card-large">
          <figure>
            <img
              src={toHref("/images/bisque/workshop/large-scale-visualization-800.webp")}
              srcset={`${toHref("/images/bisque/workshop/large-scale-visualization-800.webp")} 800w, ${toHref("/images/bisque/workshop/large-scale-visualization-1400.webp")} 1400w`}
              sizes="(max-width: 720px) calc(100vw - 28px), 1180px"
              width="1400"
              height="788"
              alt="BisQue workshop slide showing a 90K by 90K image mosaic visualized inside a web browser."
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div>
            <p class="eyebrow">Scale</p>
            <h3>Large mosaics stay inspectable in the web browser.</h3>
            <p>
              The workshop shows a 90K by 90K image mosaic in BisQue, making scale a product
              capability rather than an offline preprocessing footnote.
            </p>
          </div>
        </article>
        <article class="bisque-workshop-card">
          <figure>
            <img
              src={toHref("/images/bisque/workshop/materials-workflow-800.webp")}
              srcset={`${toHref("/images/bisque/workshop/materials-workflow-800.webp")} 800w, ${toHref("/images/bisque/workshop/materials-workflow-1400.webp")} 1400w`}
              sizes="(max-width: 720px) calc(100vw - 28px), 590px"
              width="1400"
              height="788"
              alt="BisQue workshop slide showing materials-science modules stitched into a containerized workflow."
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div>
            <p class="eyebrow">Materials science</p>
            <h3>Modules can be stitched into containerized workflows.</h3>
            <p>
              EBSD and microstructure workflows become repeatable analysis paths with visible
              inputs, module steps, and derived outputs.
            </p>
          </div>
        </article>
        <article class="bisque-workshop-card">
          <figure>
            <img
              src={toHref("/images/bisque/workshop/bioimaging-module-800.webp")}
              srcset={`${toHref("/images/bisque/workshop/bioimaging-module-800.webp")} 800w, ${toHref("/images/bisque/workshop/bioimaging-module-1400.webp")} 1400w`}
              sizes="(max-width: 720px) calc(100vw - 28px), 590px"
              width="1400"
              height="788"
              alt="BisQue workshop slide showing CellECT bioimaging segmentation and output tables."
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div>
            <p class="eyebrow">Bioimaging</p>
            <h3>Image modules return masks, metadata, and tables together.</h3>
            <p>
              Cell segmentation outputs stay connected to image viewers and table inspection, which
              is the practical base for reproducible bioimage analysis.
            </p>
          </div>
        </article>
      </div>
    </section>

    <section class="bisque-capabilities section-block" aria-label="BisQue capabilities">
      <div class="section-header research-section-heading">
        <p class="eyebrow">Platform capabilities</p>
        <h2 class="section-title">A scientific image platform built for more than file hosting.</h2>
        <p class="section-lead">
          BisQue’s value is the combination of storage, metadata, visualization, annotations, and
          executable modules. That combination is what lets computer vision research become a
          reproducible scientific workflow instead of an isolated notebook.
        </p>
      </div>
      <div class="capability-grid">
        {bisqueCapabilities.map((capability) => (
          <article class="capability-card">
            <h3>{capability.name}</h3>
            <p>{capability.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="bisque-research section-block" aria-label="BisQue-connected research">
      <div class="bisque-research-grid">
        <div class="section-header">
          <p class="eyebrow">Connected research</p>
          <h2 class="section-title">Published lab systems reuse the same image-informatics foundation.</h2>
          <p class="section-lead">
            MethaneMapper and WildlifeMapper expose BisQue dataset visualization links in their
            repositories. EBSD Superresolution and Time-lapse 3D Cell Analysis describe BisQue
            module paths for inference. The clinical neuroimaging papers extend the same lab
            pattern into MRI tumor segmentation, CT segmentation, and connectome-aware analysis.
          </p>
        </div>
        <div class="bisque-research-list">
          {researchPrograms.map((program) => (
            <a class="bisque-research-row" href={program.links[0].href} target="_blank" rel="noreferrer">
              <span>
                <strong>{program.name}</strong>
                <small>{program.domain}</small>
              </span>
              <span>{program.venue}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="research-platform section-block" aria-label="BisQue to BisQue Ultra">
      <div class="research-platform-grid">
        <div class="section-header">
          <p class="eyebrow">Next layer</p>
          <h2 class="section-title">BisQue organizes scientific resources. BisQue Ultra turns them into durable AI work.</h2>
          <p class="section-lead">
            Ultra can connect to BisQue, then adds a modern resource browser, multidimensional viewers,
            a React workbench, Go control plane, durable Postgres and NATS JetStream state, Deep Agents
            workers, gated model training, and OpenAI-compatible model routing.
          </p>
        </div>
        <div class="research-platform-steps" aria-label="BisQue and Ultra relationship">
          <a href={siteConfig.platformUrl} target="_blank" rel="noreferrer" class="platform-step">
            <span class="mono-copy">BisQue</span>
            <strong>Scientific resources</strong>
            <small>Images, datasets, annotations, tables, metadata, modules, and visualization.</small>
          </a>
          <a href={toHref("/bisque-ultra")} class="platform-step">
            <span class="mono-copy">Ultra</span>
            <strong>Scientific AI workbench</strong>
            <small>Viewers, tools, runs, model versions, training gates, artifacts, and evidence.</small>
          </a>
        </div>
      </div>
    </section>

    <section class="ultra-conversion" aria-label="BisQue collaboration">
      <div>
        <p class="eyebrow">Extend the platform</p>
        <h2>Connect a new dataset, analysis module, or scientific workflow.</h2>
        <p>
          We work with teams that need shared image infrastructure, browser-visible analysis, or a
          durable path from BisQue resources into BisQue Ultra.
        </p>
      </div>
      <div class="hero-actions">
        <a class="primary-button" href={toHref(siteConfig.accessPath)}>Collaborate with us</a>
        <a class="secondary-button" href={toHref("/bisque-ultra")}>Explore BisQue Ultra</a>
      </div>
    </section>

    <section class="research-sources section-block" aria-label="BisQue source material">
      <div class="section-header">
        <p class="eyebrow">Primary sources</p>
        <h2 class="section-title">Read the platform sources directly.</h2>
      </div>
      <div class="source-grid">
        <a href={sourceLinks.bisqueRepo} target="_blank" rel="noreferrer">BisQue UCSB repository</a>
        <a href={siteConfig.docsUrl} target="_blank" rel="noreferrer">BisQue documentation</a>
        <a href={siteConfig.platformUrl} target="_blank" rel="noreferrer">BisQue web platform</a>
        <a href={sourceLinks.researchOutreach} target="_blank" rel="noreferrer">
          Research Outreach article
        </a>
      </div>
    </section>
  </div>
</SiteShell>
