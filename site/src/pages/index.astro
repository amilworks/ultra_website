---
import SiteShell from "@/layouts/SiteShell.astro";
import { siteConfig } from "@/data/site";

const baseUrl = import.meta.env.BASE_URL;
const canonicalUrl = Astro.site ? new URL(baseUrl, Astro.site).toString() : undefined;
const toHref = (href: string) =>
  href.startsWith("/") ? `${baseUrl}${href.replace(/^\//, "")}` : href;
const homeJsonLd = canonicalUrl
  ? {
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "Center for Multimodal Learning",
      alternateName: "CML",
      url: canonicalUrl,
      parentOrganization: {
        "@type": "CollegeOrUniversity",
        name: "University of California, Santa Barbara",
      },
      department: {
        "@type": "Organization",
        name: "UCSB Electrical and Computer Engineering",
      },
      description:
        "A UCSB Electrical and Computer Engineering project home for multimodal learning systems, scientific AI infrastructure, and image research workbenches.",
      sameAs: [siteConfig.vrlUrl, siteConfig.platformUrl],
    }
  : undefined;
---

<SiteShell
  title="Center for Multimodal Learning | UCSB Electrical and Computer Engineering"
  description="Center for Multimodal Learning is a UCSB Electrical and Computer Engineering project home for multimodal learning systems, scientific AI infrastructure, BisQue Ultra, and BisQue."
  canonicalPath="/"
  image="/images/news/bisque-ultra-launch2.png"
  imageAlt="BisQue Ultra product interface used as a project preview for Center for Multimodal Learning."
  jsonLd={homeJsonLd}
>
  <div class="home-editorial lab-home">
    <section class="lab-hero section-block" aria-label="Center overview">
      <div class="lab-hero-top">
        <div class="section-header lab-hero-copy">
          <h1 class="lab-headline">Center for Multimodal Learning</h1>
          <p class="lab-affiliation">UCSB Electrical and Computer Engineering</p>
          <p class="lab-subhead">
            A project home for scientific AI systems that keep multimodal data, model-guided tools,
            durable runs, and inspectable evidence connected.
          </p>
          <div class="launch-command-line lab-command-line" aria-label="Research themes">
            <span>Scientific AI</span>
            <span>Image research</span>
            <span>Multimodal systems</span>
            <span>Reproducible artifacts</span>
          </div>
        </div>
        <aside class="surface-card lab-index-panel" aria-label="Project index">
          <p class="eyebrow">Project index</p>
          <a class="lab-index-row" href={toHref("/bisque-ultra")}>
            <span>
              <strong>BisQue Ultra</strong>
              <small>Scientific AI workbench and durable run-control plane.</small>
            </span>
            <span class="mono-copy">Live</span>
          </a>
          <a class="lab-index-row" href={toHref("/bisque")}>
            <span>
              <strong>BisQue</strong>
              <small>Scientific image platform page reserved for the next content pass.</small>
            </span>
            <span class="mono-copy">Soon</span>
          </a>
          <a class="lab-index-row" href={toHref("/news")}>
            <span>
              <strong>Product news</strong>
              <small>Launch notes, platform context, and interface updates.</small>
            </span>
            <span class="mono-copy">Read</span>
          </a>
        </aside>
      </div>

      <div class="hero-actions launch-actions">
        <a class="primary-button" href={toHref("/bisque-ultra")}>Explore BisQue Ultra</a>
        <a class="secondary-button" href={toHref("/bisque")}>Open BisQue page</a>
      </div>

      <div class="proof-strip lab-proof" aria-label="Center focus areas">
        <article class="proof-item">
          <p class="eyebrow">Systems</p>
          <h3 class="proof-item-title">Build multimodal tools around real scientific work.</h3>
          <p class="proof-item-body">
            The center site foregrounds projects that connect images, metadata, models, code, and artifacts.
          </p>
        </article>
        <article class="proof-item">
          <p class="eyebrow">Evidence</p>
          <h3 class="proof-item-title">Treat output as something a researcher can inspect.</h3>
          <p class="proof-item-body">
            Project pages emphasize provenance, reproducibility, durable runs, and readable product surfaces.
          </p>
        </article>
        <article class="proof-item">
          <p class="eyebrow">Infrastructure</p>
          <h3 class="proof-item-title">Make platform boundaries clear before claims get large.</h3>
          <p class="proof-item-body">
            Each project can explain what is live, what is deployment-configured, and what will come next.
          </p>
        </article>
      </div>
    </section>

    <section class="lab-projects section-block" aria-label="Projects">
      <div class="section-header">
        <h2 class="section-title">Projects</h2>
        <p class="section-lead">
          The home page now acts as the center doorway. BisQue Ultra keeps its own launch page, while BisQue
          has a dedicated page ready for future writing.
        </p>
      </div>
      <div class="lab-project-grid">
        <a class="surface-card lab-project-card lab-project-card-featured" href={toHref("/bisque-ultra")}>
          <img
            src={toHref("/images/news/bisque-ultra-launch2.png")}
            alt="BisQue Ultra interface preview."
            loading="lazy"
            decoding="async"
          />
          <span>
            <p class="eyebrow">BisQue Ultra</p>
            <h3>Scientific AI workbench and durable run-control plane.</h3>
            <p>
              The launch page explains the React workbench, Go control plane, Deep Agents runtime,
              BisQue resources, and reproducible artifact record.
            </p>
          </span>
        </a>
        <a class="surface-card lab-project-card" href={toHref("/bisque")}>
          <span>
            <p class="eyebrow">BisQue</p>
            <h3>Scientific image platform page reserved for the next content pass.</h3>
            <p>
              This route is live now so the site structure can grow around BisQue, BisQue Ultra, and future
              multimodal learning systems without changing the navigation model again.
            </p>
          </span>
        </a>
      </div>
    </section>
  </div>
</SiteShell>
