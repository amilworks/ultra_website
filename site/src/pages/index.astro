---
import SiteShell from "@/layouts/SiteShell.astro";
import { siteConfig } from "@/data/site";
import { researchPrograms, sourceLinks } from "@/data/research";

const baseUrl = import.meta.env.BASE_URL;
const canonicalUrl = Astro.site ? new URL(baseUrl, Astro.site).toString() : undefined;
const toHref = (href: string) =>
  href.startsWith("/") ? `${baseUrl}${href.replace(/^\//, "")}` : href;
const homeJsonLd = canonicalUrl
  ? {
      "@context": "https://schema.org",
      "@type": "ResearchOrganization",
      name: "Center for Multimodal Learning",
      alternateName: "CML",
      url: canonicalUrl,
      parentOrganization: {
        "@type": "CollegeOrUniversity",
        name: "University of California, Santa Barbara",
      },
      department: {
        "@type": "Organization",
        name: "UCSB Electrical and Computer Engineering",
      },
      description:
        "A UCSB Electrical and Computer Engineering project home for Bright 4B, hyperspherical learning, computer vision, multimodal learning, scientific image informatics, and reproducible AI workbenches.",
      knowsAbout: [
        "Bright 4B",
        "hyperspherical learning",
        "computer vision",
        "multimodal learning",
        "scientific image informatics",
        "3D brightfield microscopy",
        "label-free 3D segmentation",
        "hyperspectral methane detection",
        "aerial wildlife detection",
        "clinical neuroimaging",
        "brain tumor segmentation",
        "normal pressure hydrocephalus prediction",
        "EBSD super-resolution",
        "3D cell image analysis",
      ],
      sameAs: [
        siteConfig.vrlUrl,
        siteConfig.platformUrl,
        sourceLinks.bisqueRepo,
        sourceLinks.ultraRepo,
        sourceLinks.methaneMapperRepo,
        sourceLinks.wildlifeMapperRepo,
        sourceLinks.ebsdRepo,
        sourceLinks.cellAnalysisRepo,
        sourceLinks.bright4bPaper,
        sourceLinks.brainTumorPaper,
        sourceLinks.hydrocephalusPaper,
        sourceLinks.cellAnalysisPaper,
        sourceLinks.researchOutreach,
      ],
    }
  : undefined;
---

<SiteShell
  title="Center for Multimodal Learning | Scientific AI at UCSB"
  description="Center for Multimodal Learning at UCSB ECE builds Bright 4B, scientific computer vision methods, BisQue image informatics, and BisQue Ultra — an agentic system that runs real research where the data live."
  canonicalPath="/"
  image="/images/releases/bisque-ultra-og-2026-07.png"
  imageAlt="BisQue Ultra color field used across the Center for Multimodal Learning research site."
  jsonLd={homeJsonLd}
>
  <div class="home-editorial lab-home research-home">
    <section class="lab-hero research-hero section-block" aria-label="Center overview">
      <div class="research-hero-grid">
        <div class="section-header lab-hero-copy">
          <h1 class="lab-headline">Center for Multimodal Learning</h1>
          <p class="lab-affiliation">UCSB Electrical and Computer Engineering</p>
          <p class="lab-subhead">
            We build computer vision around the measurements that make science hard — label-free 3D
            microscopy, hyperspectral remote sensing, aerial ecology, clinical neuroimaging, materials
            characterization — and the system that carries those methods out: BisQue Ultra, an agentic
            platform that runs real research where the data live, with the evidence attached.
          </p>
          <div class="launch-command-line lab-command-line" aria-label="Research themes">
            <span>Bright 4B</span>
            <span>Computer vision</span>
            <span>Multimodal learning</span>
            <span>Scientific image informatics</span>
            <span>Agentic research systems</span>
          </div>
          <div class="hero-actions launch-actions">
            <a class="primary-button" href={toHref("/bisque-ultra")}>Explore BisQue Ultra</a>
            <a class="secondary-button" href={toHref("/bisque")}>Open BisQue platform</a>
          </div>
        </div>
        <figure class="research-atlas-frame research-ultra-hero-frame">
          <img
            src={toHref("/images/home/ultra-hero-960.webp")}
            srcset={`${toHref("/images/home/ultra-hero-960.webp")} 960w, ${toHref("/images/home/ultra-hero-1600.webp")} 1600w`}
            sizes="(max-width: 820px) calc(100vw - 28px), 50vw"
            width="1600"
            height="903"
            alt="BisQue Ultra color field used across the Center for Multimodal Learning research site."
            fetchpriority="high"
            decoding="async"
          />
          <div class="research-ultra-hero-panel" aria-hidden="true">
            <span class="mono-copy">BRIGHT 4B</span>
            <strong>3D brightfield microscopy</strong>
            <small>Label-free 3D segmentation evidence organized in the BisQue Ultra workbench.</small>
          </div>
          <figcaption>
            A visual field for the lab stack: scientific vision models, BisQue image informatics,
            and the BisQue Ultra agentic workbench.
          </figcaption>
        </figure>
      </div>

      <div class="proof-strip lab-proof research-proof" aria-label="Center focus areas">
        <article class="proof-item">
          <p class="eyebrow">Measurement-aware models</p>
          <p class="proof-item-title">The measurement shapes the model.</p>
          <p class="proof-item-body">
            Spectral absorption, species identity, brain anatomy, crystallographic symmetry, and 3D
            cell structure each dictate the method. The physics comes first; the network follows.
          </p>
        </article>
        <article class="proof-item">
          <p class="eyebrow">Shared substrate</p>
          <p class="proof-item-title">BisQue keeps data, metadata, annotation, and analysis close.</p>
          <p class="proof-item-body">
            A scalable image platform gives research code a browser-visible path into datasets,
            modules, and inspectable outputs — the catalog an agent can operate on.
          </p>
        </article>
        <article class="proof-item">
          <p class="eyebrow">Agentic research systems</p>
          <p class="proof-item-title">BisQue Ultra runs the work, with receipts.</p>
          <p class="proof-item-body">
            A governed agent plans and acts through the platform's own services — durable runs, gated
            training, inspectable evidence — measured live at 59&nbsp;ms to first token, zero errors under load.
          </p>
        </article>
      </div>
    </section>

    <section class="lens-showcase section-block" aria-label="The Lens scientific viewer">
      <div class="section-header research-section-heading">
        <p class="eyebrow">The Lens viewer</p>
        <h2 class="section-title">One viewer for what the instrument produces — and what the agent returns.</h2>
        <p class="section-lead">
          Lens is where the workbench meets the data. It opens the multidimensional files scientific
          instruments actually write, with real physical units and windowing, and it renders the
          figures the agent generates in the same surface — so a result never leaves the context that
          produced it.
        </p>
      </div>
      <div class="lens-grid">
        <figure class="lens-card">
          <div class="lens-shot">
            <img
              src={toHref("/images/home/lens-clinical-ct.webp")}
              width="1300"
              height="819"
              alt="Lens viewer showing an axial clinical CT slice of a head with Hounsfield-unit windowing, z-slice scrubbing at 18 of 34, and 0.39 x 0.39 x 5.00 mm anisotropic voxel spacing."
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption>
            <p class="eyebrow">Clinical CT · NIfTI</p>
            <p class="lens-card-title">The instrument's data, with its physics intact.</p>
            <p>
              A thoracic-window head CT with Hounsfield-unit windowing, z-scrub across 34 planes, and
              anisotropic voxel spacing read straight from the volume — not flattened to a screenshot.
            </p>
          </figcaption>
        </figure>
        <figure class="lens-card">
          <div class="lens-shot">
            <img
              src={toHref("/images/home/lens-agent-heatmap.webp")}
              width="1300"
              height="990"
              alt="Lens viewer showing an agent-generated spatial detection density heatmap over a 6000 by 4000 pixel aerial survey, with individual burrow and prairie-dog detections overlaid and a normalized KDE density colorbar."
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption>
            <p class="eyebrow">Agent output · detection density</p>
            <p class="lens-card-title">The agent's result, in the same surface.</p>
            <p>
              A spatial detection-density heatmap over a 6,000&nbsp;×&nbsp;4,000 aerial survey, with
              individual prairie-dog and burrow detections overlaid — an artifact the agent produced
              during a run, opened like any other resource.
            </p>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="bright4b-feature section-block" id="bright-4b" aria-label="Bright 4B research">
      <div class="section-header research-section-heading">
        <p class="eyebrow">Bright 4B</p>
        <h2 class="section-title">Bright 4B scales hyperspherical learning to 3D brightfield microscopy.</h2>
        <p class="section-lead">
          Bright 4B is a 4B-parameter foundation model that learns on the unit hypersphere to segment
          subcellular structures directly from 3D brightfield volumes. Native Sparse Attention,
          residual HyperConnections, soft Mixture-of-Experts, and anisotropic patch embedding address
          context, representation flow, adaptive capacity, and confocal geometry without requiring
          fluorescence or handcrafted post-processing.
        </p>
      </div>

      <div class="bright4b-showcase">
        <figure class="bright4b-figure bright4b-figure-large">
          <img
            src={toHref("/images/home/bright4b/broader-vision-800.webp")}
            srcset={`${toHref("/images/home/bright4b/broader-vision-800.webp")} 800w, ${toHref("/images/home/bright4b/broader-vision-1400.webp")} 1400w`}
            sizes="(max-width: 720px) calc(100vw - 28px), 1180px"
            width="1400"
            height="788"
            alt="Bright 4B broader vision slide showing brightfield inputs, pseudo-labels, predictions, and zoomed 3D morphology outputs."
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            Bright 4B connects raw brightfield volumes to morphology-aware 3D segmentation across
            structures and acquisition regimes.
          </figcaption>
        </figure>
        <div class="bright4b-evidence-grid">
          <article class="bright4b-evidence-card">
            <figure>
              <img
                src={toHref("/images/home/bright4b/geometry-aware-representation-800.webp")}
                srcset={`${toHref("/images/home/bright4b/geometry-aware-representation-800.webp")} 800w, ${toHref("/images/home/bright4b/geometry-aware-representation-1400.webp")} 1400w`}
                sizes="(max-width: 720px) calc(100vw - 28px), 590px"
                width="1400"
                height="788"
                alt="Bright 4B geometry-aware input representation slide with PSF-aware 3D patching."
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div>
              <p class="eyebrow">Representation</p>
              <h3>PSF-aware patch embeddings preserve axial structure.</h3>
              <p>
                The model respects point-spread behavior and axial thinning before global reasoning
                begins, preserving fine structure across depth.
              </p>
            </div>
          </article>
          <article class="bright4b-evidence-card">
            <figure>
              <img
                src={toHref("/images/home/bright4b/biological-task-output-800.webp")}
                srcset={`${toHref("/images/home/bright4b/biological-task-output-800.webp")} 800w, ${toHref("/images/home/bright4b/biological-task-output-1400.webp")} 1400w`}
                sizes="(max-width: 720px) calc(100vw - 28px), 590px"
                width="1400"
                height="788"
                alt="Bright 4B output slide showing predicted 3D masks for nuclei, mitochondria, and microtubules."
                loading="lazy"
                decoding="async"
              />
            </figure>
            <div>
              <p class="eyebrow">Biological output</p>
              <h3>Label-free masks become inspectable scientific evidence.</h3>
              <p>
                Nuclei, mitochondria, microtubules, and related structures can be compared as
                segmentation outputs rather than treated as opaque model responses.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="research-programs section-block" id="research-programs" aria-label="Research programs">
      <div class="section-header research-section-heading">
        <p class="eyebrow">Research programs</p>
        <h2 class="section-title">Published computer vision across five scientific domains.</h2>
        <p class="section-lead">
          The lab's public work spans remote sensing, ecology, clinical neuroimaging, materials
          science, and bioimage analysis. Each program begins with the geometry, physics, or biology
          of the measurement and ends with code, data, or a platform path that other researchers can inspect.
        </p>
      </div>
      <div class="research-program-list">
        {researchPrograms.map((program, index) => (
          <article class="research-program-card">
            <div class="research-program-index mono-copy">{String(index + 1).padStart(2, "0")}</div>
            <div>
              <p class="eyebrow">{program.domain}</p>
              <h3>{program.title}</h3>
              <p class="research-program-summary">{program.summary}</p>
            </div>
            <div class="research-program-evidence">
              <p class="research-program-venue">{program.venue}</p>
              <p>{program.evidence}</p>
              <div class="source-links" aria-label={`${program.name} source links`}>
                {program.links.map((link) => (
                  <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="research-platform section-block" aria-label="Infrastructure platform">
      <div class="research-platform-grid">
        <div class="section-header">
          <p class="eyebrow">Platform layer</p>
          <h2 class="section-title">Research methods become more useful when the infrastructure is shared.</h2>
          <p class="section-lead">
            BisQue, Bright 4B, BisQue Ultra, and the public research repositories form one visible
            chain: scientific data enters a scalable image platform — one whose pilot already holds
            nearly six million image uploads and 12.3 million annotations — domain-shaped models
            operate close to the data, and the agentic workbench preserves the run, outputs, and evidence.
          </p>
        </div>
        <div class="research-platform-steps" aria-label="Lab platform sequence">
          <a href={toHref("/bisque")} class="platform-step">
            <span class="mono-copy">01</span>
            <strong>BisQue image informatics</strong>
            <small>Store, annotate, search, visualize, and run scientific image analyses.</small>
          </a>
          <a href="#research-programs" class="platform-step">
            <span class="mono-copy">02</span>
            <strong>Scientific vision methods</strong>
            <small>Publish domain-shaped models, datasets, weights, and reproducible code paths.</small>
          </a>
          <a href={toHref("/bisque-ultra")} class="platform-step">
            <span class="mono-copy">03</span>
            <strong>BisQue Ultra agent</strong>
            <small>A governed agent runs the analysis, gates model updates, and keeps durable artifacts.</small>
          </a>
        </div>
      </div>
    </section>

    <section class="ultra-conversion lab-collaboration" aria-label="Research collaboration">
      <div>
        <p class="eyebrow">Collaborate</p>
        <h2>Work with us on the next scientific vision system.</h2>
        <p>
          We work with researchers, infrastructure teams, and frontier labs on new imaging methods,
          multimodal datasets, model evaluation, scientific viewers, and agentic research workflows.
          Tell us what you measure and where the evidence currently breaks apart.
        </p>
      </div>
      <div class="hero-actions">
        <a class="primary-button" href={toHref(siteConfig.accessPath)}>Start a conversation</a>
        <a class="secondary-button" href={toHref("/news")}>Read project notes</a>
      </div>
    </section>

    <section class="research-sources section-block" aria-label="Source material">
      <div class="section-header">
        <p class="eyebrow">Publications and code</p>
        <h2 class="section-title">Read the primary work.</h2>
      </div>
      <div class="source-grid">
        <a href={sourceLinks.bright4bPaper} target="_blank" rel="noreferrer">Bright 4B arXiv paper</a>
        <a href={sourceLinks.bisqueRepo} target="_blank" rel="noreferrer">BisQue UCSB repository</a>
        <a href={sourceLinks.ultraRepo} target="_blank" rel="noreferrer">BisQue Ultra repository</a>
        <a href={sourceLinks.researchOutreach} target="_blank" rel="noreferrer">
          Research Outreach: reproducible computer vision
        </a>
        <a href={siteConfig.vrlUrl} target="_blank" rel="noreferrer">UCSB Vision Research Lab</a>
      </div>
    </section>
  </div>
</SiteShell>
