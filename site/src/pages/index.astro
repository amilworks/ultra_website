---
import SiteShell from "@/layouts/SiteShell.astro";
import { formatLongDate, getFeaturedNews, getLatestNews } from "@/lib/content";
import ProofStrip from "@/components/ProofStrip.astro";
import { siteConfig } from "@/data/site";

const featuredStory = await getFeaturedNews();
const latestNews = await getLatestNews(2, featuredStory?.data.slug);
const baseUrl = import.meta.env.BASE_URL;
const canonicalUrl = Astro.site ? new URL(baseUrl, Astro.site).toString() : undefined;
const homeJsonLd = canonicalUrl
  ? {
      "@context": "https://schema.org",
      "@type": "WebPage",
      name: "BisQue Ultra",
      description:
        "BisQue Ultra is a scientific AI control plane for image research, durable autonomous runs, and reproducible artifacts.",
      url: canonicalUrl,
      about: {
        "@type": "SoftwareApplication",
        name: "BisQue Ultra",
        applicationCategory: "ScientificApplication",
        operatingSystem: "Web",
        applicationSubCategory: "Scientific AI workbench",
        description:
          "A React workbench, Go control plane, Deep Agents worker runtime, and BisQue data layer for scientific imaging workflows.",
        codeRepository: siteConfig.repoUrl,
        softwareVersion: "0.1.0",
        keywords:
          "BisQue Ultra, scientific AI, scientific imaging workbench, Go control plane, Deep Agents, run provenance, artifact lineage, BisQue platform",
        offers: {
          "@type": "Offer",
          availability: "https://schema.org/InDevelopment",
        },
      },
      publisher: {
        "@type": "Organization",
        name: "UCSB Vision Research Lab",
        url: "https://vision.ece.ucsb.edu",
      },
    }
  : undefined;

const toHref = (href: string) =>
  href.startsWith("/") ? `${baseUrl}${href.replace(/^\//, "")}` : href;

if (!featuredStory) {
  throw new Error("Expected at least one news entry for the site homepage.");
}

const homeImage = "/images/news/bisque-ultra-launch2.png";
const homeImageAlt =
  "BisQue Ultra product interface showing a scientific report, integrated prompt composer, and structured analysis surface.";
const launchHeroImage = homeImage;
const launchHeroImageAlt = homeImageAlt;
const primaryTileImage = "/images/news/bisque-ultra-launch2.png";
const primaryTileImageAlt =
  "BisQue Ultra showing a prairie dog detection report in a structured interface with a calm sidebar, readable report surface, and integrated prompt composer.";
---

<SiteShell
  title="BisQue Ultra | Scientific AI Workbench and Run Control Plane"
  description="BisQue Ultra is a scientific AI workbench and durable run-control plane for BisQue image resources, Deep Agents workers, reproducible artifacts, and frontier image research."
  canonicalPath="/"
  image={homeImage}
  imageAlt={homeImageAlt}
  jsonLd={homeJsonLd}
>
  <div class="home-editorial">
    <section class="launch-hero section-block" aria-label="Launch overview">
      <div class="launch-hero-top">
        <div class="section-header launch-hero-copy">
          <h1 class="launch-headline">BisQue Ultra</h1>
          <p class="launch-claim">Scientific AI run control for image research.</p>
          <p class="launch-subhead">
            BisQue Ultra connects BisQue resources, multidimensional image analysis, model-guided tools,
            durable autonomous runs, and reproducible artifacts in one inspectable product record.
          </p>
          <div class="launch-command-line" aria-label="Current stack">
            <span>React workbench</span>
            <span>Go run contract</span>
            <span>Deep Agents runtime</span>
            <span>Postgres + NATS JetStream</span>
          </div>
        </div>
        <a
          class="launch-hero-art"
          href={toHref(`/news/${featuredStory.data.slug}`)}
          aria-label={`Open ${featuredStory.data.title}`}
        >
          <img
            class="launch-hero-art-image"
            src={toHref(launchHeroImage)}
            alt={launchHeroImageAlt}
            loading="eager"
            decoding="async"
          />
        </a>
      </div>
      <div class="hero-actions launch-actions">
        <a class="primary-button" href={toHref(`/news/${featuredStory.data.slug}`)}>Read the launch brief</a>
        <a class="secondary-button" href={siteConfig.repoUrl} target="_blank" rel="noreferrer">View the repository</a>
      </div>
      <ProofStrip
        items={[
          {
            label: "Control plane",
            title: "Go owns the run contract",
            body: "Threads, messages, runs, events, artifacts, users, organizations, idempotency keys, and worker leases have a durable API spine.",
          },
          {
            label: "Durability",
            title: "Postgres and NATS JetStream keep long work recoverable",
            body: "Run state, event streams, worker heartbeats, leases, and dispatch survive refreshes, reconnects, and worker restarts.",
          },
          {
            label: "Model layer",
            title: "OpenAI-compatible model layer",
            body: "The worker contract can point at vLLM, Ollama, or another compatible server without rebuilding the product around one vendor.",
          },
          {
            label: "Scientific substrate",
            title: "BisQue resources stay first-class",
            body: "Search, load, download, upload, tag, annotate, create datasets, run modules, and inspect scientific resources from the workbench.",
          },
        ]}
      />
    </section>

    <section class="launch-update section-block" aria-label="Product update">
      <div class="section-header">
        <h2 class="section-title">The updated app is no longer a polished chat surface. It is run-control infrastructure.</h2>
        <p class="section-lead">
          BisQue Ultra now separates the system into a React client, a Go control plane, durable Postgres
          state, NATS JetStream dispatch, Python Deep Agents workers, deployment-configured vision services,
          and a replaceable OpenAI-compatible model endpoint.
        </p>
      </div>
      <div class="architecture-rail" aria-label="BisQue Ultra architecture">
        <article>
          <span class="mono-copy">01</span>
          <h3>BisQue data layer</h3>
          <p>Images, datasets, tables, metadata, annotations, and modules remain the scientific record.</p>
        </article>
        <article>
          <span class="mono-copy">02</span>
          <h3>Go control plane</h3>
          <p>Auth, threads, runs, leases, events, artifacts, admin state, and the OpenAPI contract live here.</p>
        </article>
        <article>
          <span class="mono-copy">03</span>
          <h3>Deep Agents runtime</h3>
          <p>Workers execute long-running tool work, code execution, paper/research routing, and RareSpot flows.</p>
        </article>
        <article>
          <span class="mono-copy">04</span>
          <h3>React workbench</h3>
          <p>The interface keeps resource browsing, composer workflows, run steps, artifacts, and viewers visible.</p>
        </article>
      </div>
    </section>

    <section class="launch-spotlight" aria-label="Flagship launch and supporting notes">
      <article class="launch-primary">
        <a
          class="story-tile story-tile-large"
          data-tone="image"
          data-has-image="true"
          href={toHref(`/news/${featuredStory.data.slug}`)}
          aria-label={`Open ${featuredStory.data.title}`}
        >
          <img
            class="story-tile-image"
            src={toHref(primaryTileImage)}
            alt={primaryTileImageAlt}
            style="object-position: 50% 50%"
            loading="eager"
            decoding="async"
          />
        </a>
        <div class="launch-primary-copy">
          <p class="eyebrow">Launch brief</p>
          <h2 class="story-headline">{featuredStory.data.title}</h2>
          <p class="story-summary">{featuredStory.data.excerpt}</p>
          <p class="story-meta">
            <span>{featuredStory.data.kind}</span>
            <span>{formatLongDate(featuredStory.data.date)}</span>
          </p>
          <div class="hero-actions">
            <a class="primary-button" href={toHref(`/news/${featuredStory.data.slug}`)}>
              Open the launch brief
            </a>
            <a class="secondary-button" href={toHref("/news")}>Browse product news</a>
          </div>
        </div>
      </article>

      <aside class="launch-reading">
        <div class="section-header">
          <p class="eyebrow">Read next</p>
          <h2 class="section-title">Then read the platform and interface updates.</h2>
          <p class="section-lead">
            The strongest product story is not a slogan. It is the chain from scientific substrate to
            durable control plane to inspectable product surface.
          </p>
        </div>
        <div class="launch-reading-grid">
          {latestNews.map((entry) => (
            <a class="launch-reading-card" href={toHref(`/news/${entry.data.slug}`)}>
              <p class="launch-reading-meta">
                <span class="post-card-sequence mono-copy">
                  {String(entry.data.sequence ?? 0).padStart(2, "0")}
                </span>
                <span>{entry.data.kind}</span>
              </p>
              <h3 class="story-rail-title">{entry.data.title}</h3>
              <p class="story-summary story-summary-rail">{entry.data.excerpt}</p>
            </a>
          ))}
        </div>
      </aside>
    </section>

    <section class="home-intro section-block">
      <div class="section-header">
        <p class="eyebrow">Product surface</p>
        <h2 class="section-title">A scientific workbench with launch-grade infrastructure underneath.</h2>
        <p class="section-lead">
          The current frontend exposes the details that serious image research needs: resource navigation,
          workflow presets, Pro Mode, run recovery, artifact hydration, scientific result cards, and viewers
          for image and volume inspection.
        </p>
      </div>
      <figure class="surface-card home-platform-preview">
        <img
          class="home-platform-preview-image home-platform-preview-image-light"
          src={toHref("/images/home/platform-preview-light.png")}
          alt="Light mode BisQue Ultra report view showing a transformer report with structured reading layout."
          loading="lazy"
          decoding="async"
        />
        <img
          class="home-platform-preview-image home-platform-preview-image-dark"
          src={toHref("/images/home/platform-preview-dark.png")}
          alt="Dark mode BisQue Ultra report view showing a transformer report with structured reading layout."
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="home-notes-grid">
        <article class="flat-note">
          <p class="eyebrow">Resource operations</p>
          <h3 class="flat-note-title">Search, stage, modify, and run against BisQue resources.</h3>
          <p class="flat-note-copy">
            The composer includes workflows for BisQue search, metadata loading, downloads, uploads,
            dataset creation, tag updates, annotations, XML inspection, deletion, and module execution.
          </p>
        </article>
        <article class="flat-note">
          <p class="eyebrow">Vision workflows</p>
          <h3 class="flat-note-title">Domain tools are routed through the same run record.</h3>
          <p class="flat-note-copy">
            Deployment-configured vision workflows, RareSpot prairie analysis, scientific calculators,
            chemistry tools, and code execution can produce structured outputs and artifacts.
          </p>
        </article>
        <article class="flat-note">
          <p class="eyebrow">Run memory</p>
          <h3 class="flat-note-title">The answer is not detached from the system that produced it.</h3>
          <p class="flat-note-copy">
            Past chats hydrate from durable thread messages, run artifacts remain downloadable, stream
            recovery survives refreshes, and scientific result groups retain reports, figures, and metrics.
          </p>
        </article>
      </div>

      <aside class="surface-card home-acknowledgement">
        <div class="home-acknowledgement-copy">
          <p class="eyebrow">About BisQue Ultra</p>
          <h3 class="flat-note-title">Created within the UCSB Vision Research Lab.</h3>
          <p class="flat-note-copy">
            BisQue Ultra was created by Amil Khan, a PhD student in the UCSB Vision Research Lab. The lab
            is led by Professor <a href="https://scholar.google.com/citations?user=wRYM4qgAAAAJ&amp;hl=en" target="_blank" rel="noreferrer">B.S. Manjunath</a> in the Department of Electrical and Computer Engineering,
            with research spanning computer vision, image processing, and machine learning applications.
          </p>
        </div>
        <div class="home-acknowledgement-links">
          <a class="subtle-link" href="https://vision.ece.ucsb.edu" target="_blank" rel="noreferrer">
            Visit UCSB VRL
          </a>
          <a class="subtle-link" href="https://bisque.gitbook.io/docs/" target="_blank" rel="noreferrer">
            Read BisQue docs
          </a>
        </div>
      </aside>
    </section>
  </div>
</SiteShell>
