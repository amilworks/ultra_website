---
import SiteShell from "@/layouts/SiteShell.astro";
import { siteConfig } from "@/data/site";
import { researchPrograms, sourceLinks } from "@/data/research";

const baseUrl = import.meta.env.BASE_URL;
const canonicalUrl = Astro.site ? new URL(baseUrl, Astro.site).toString() : undefined;
const toHref = (href: string) =>
  href.startsWith("/") ? `${baseUrl}${href.replace(/^\//, "")}` : href;
const homeJsonLd = canonicalUrl
  ? {
      "@context": "https://schema.org",
      "@type": "ResearchOrganization",
      name: "Center for Multimodal Learning",
      alternateName: "CML",
      url: canonicalUrl,
      parentOrganization: {
        "@type": "CollegeOrUniversity",
        name: "University of California, Santa Barbara",
      },
      department: {
        "@type": "Organization",
        name: "UCSB Electrical and Computer Engineering",
      },
      description:
        "A UCSB Electrical and Computer Engineering project home for computer vision, multimodal learning, scientific image informatics, and reproducible AI workbenches.",
      knowsAbout: [
        "computer vision",
        "multimodal learning",
        "scientific image informatics",
        "hyperspectral methane detection",
        "aerial wildlife detection",
        "clinical neuroimaging",
        "brain tumor segmentation",
        "normal pressure hydrocephalus prediction",
        "EBSD super-resolution",
        "3D cell image analysis",
      ],
      sameAs: [
        siteConfig.vrlUrl,
        siteConfig.platformUrl,
        sourceLinks.bisqueRepo,
        sourceLinks.ultraRepo,
        sourceLinks.methaneMapperRepo,
        sourceLinks.wildlifeMapperRepo,
        sourceLinks.ebsdRepo,
        sourceLinks.cellAnalysisRepo,
        sourceLinks.brainTumorPaper,
        sourceLinks.hydrocephalusPaper,
        sourceLinks.cellAnalysisPaper,
        sourceLinks.researchOutreach,
      ],
    }
  : undefined;
---

<SiteShell
  title="Center for Multimodal Learning | Frontier Computer Vision at UCSB ECE"
  description="Center for Multimodal Learning is a UCSB Electrical and Computer Engineering project home for frontier computer vision, multimodal learning, BisQue image informatics, and scientific AI workbenches."
  canonicalPath="/"
  image="/images/home/cml-research-atlas.png"
  imageAlt="Research atlas showing hyperspectral methane sensing, aerial wildlife mapping, materials microscopy, and 3D cell analysis."
  jsonLd={homeJsonLd}
>
  <div class="home-editorial lab-home research-home">
    <section class="lab-hero research-hero section-block" aria-label="Center overview">
      <div class="research-hero-grid">
        <div class="section-header lab-hero-copy">
          <h1 class="lab-headline">Center for Multimodal Learning</h1>
          <p class="lab-affiliation">UCSB Electrical and Computer Engineering</p>
          <p class="lab-subhead">
            Frontier computer vision for scientific data: hyperspectral methane sensing, aerial
            wildlife mapping, clinical neuroimaging, materials microscopy, time-lapse 3D cell
            analysis, and the image informatics systems that make those workflows reproducible.
          </p>
          <div class="launch-command-line lab-command-line" aria-label="Research themes">
            <span>Computer vision</span>
            <span>Multimodal learning</span>
            <span>Scientific image informatics</span>
            <span>Reproducible AI systems</span>
          </div>
          <figure class="research-atlas-frame">
            <img
              src={toHref("/images/home/cml-research-atlas.png")}
              alt="A calm research atlas combining methane hyperspectral imaging, wildlife aerial imagery, EBSD materials maps, and 3D cell microscopy."
              decoding="async"
            />
            <figcaption>
              A visual atlas of lab-scale image AI, from remote sensing and ecology to materials
              microscopy and 3D cell analysis.
            </figcaption>
          </figure>
          <div class="hero-actions launch-actions">
            <a class="primary-button" href={toHref("/bisque")}>Open BisQue platform</a>
            <a class="secondary-button" href={toHref("/bisque-ultra")}>BisQue Ultra</a>
          </div>
        </div>
      </div>

      <div class="proof-strip lab-proof research-proof" aria-label="Center focus areas">
        <article class="proof-item">
          <p class="eyebrow">Science-first AI</p>
          <h3 class="proof-item-title">Models are built around the measurement, not the other way around.</h3>
          <p class="proof-item-body">
            Spectral absorption, species identification, brain anatomy, crystallographic symmetry,
            and 3D cell structure each shape the method.
          </p>
        </article>
        <article class="proof-item">
          <p class="eyebrow">Shared substrate</p>
          <h3 class="proof-item-title">BisQue keeps data, metadata, annotation, and visualization close.</h3>
          <p class="proof-item-body">
            The platform gives research code a browser-visible path into datasets, modules, and
            inspectable outputs.
          </p>
        </article>
        <article class="proof-item">
          <p class="eyebrow">Run control</p>
          <h3 class="proof-item-title">BisQue Ultra turns model work into durable scientific runs.</h3>
          <p class="proof-item-body">
            The newer workbench connects BisQue resources, Go orchestration, Deep Agents workers,
            and OpenAI-compatible model endpoints.
          </p>
        </article>
      </div>
    </section>

    <section class="research-programs section-block" id="research-programs" aria-label="Research programs">
      <div class="section-header research-section-heading">
        <p class="eyebrow">Research programs</p>
        <h2 class="section-title">Computer vision that stays accountable to scientific evidence.</h2>
        <p class="section-lead">
          The lab’s public work spans remote sensing, ecology, clinical neuroimaging, materials
          science, and bioimage analysis. The common thread is not a single benchmark; it is the
          discipline of turning complex images into usable, reviewable scientific evidence.
        </p>
      </div>
      <div class="research-program-list">
        {researchPrograms.map((program, index) => (
          <article class="research-program-card">
            <div class="research-program-index mono-copy">{String(index + 1).padStart(2, "0")}</div>
            <div>
              <p class="eyebrow">{program.domain}</p>
              <h3>{program.title}</h3>
              <p class="research-program-summary">{program.summary}</p>
            </div>
            <div class="research-program-evidence">
              <p class="research-program-venue">{program.venue}</p>
              <p>{program.evidence}</p>
              <div class="source-links" aria-label={`${program.name} source links`}>
                {program.links.map((link) => (
                  <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="research-platform section-block" aria-label="Infrastructure platform">
      <div class="research-platform-grid">
        <div class="section-header">
          <p class="eyebrow">Platform layer</p>
          <h2 class="section-title">The website is not just a portfolio. It is a map of the lab stack.</h2>
          <p class="section-lead">
            BisQue, BisQue Ultra, and the public research repositories form a visible chain:
            scientific images enter a scalable image platform, analysis modules and models run close
            to the data, and newer agentic workflows create durable product records.
          </p>
        </div>
        <div class="research-platform-steps" aria-label="Lab platform sequence">
          <a href={toHref("/bisque")} class="platform-step">
            <span class="mono-copy">01</span>
            <strong>BisQue image informatics</strong>
            <small>Store, annotate, search, visualize, and run scientific image analyses.</small>
          </a>
          <a href="#research-programs" class="platform-step">
            <span class="mono-copy">02</span>
            <strong>Frontier vision methods</strong>
            <small>Publish domain-shaped models, datasets, weights, and reproducible code paths.</small>
          </a>
          <a href={toHref("/bisque-ultra")} class="platform-step">
            <span class="mono-copy">03</span>
            <strong>BisQue Ultra run control</strong>
            <small>Connect model-guided work to durable state, events, workers, and artifacts.</small>
          </a>
        </div>
      </div>
    </section>

    <section class="research-sources section-block" aria-label="Source material">
      <div class="section-header">
        <p class="eyebrow">Source material</p>
        <h2 class="section-title">Primary links behind this landing page.</h2>
      </div>
      <div class="source-grid">
        <a href={sourceLinks.bisqueRepo} target="_blank" rel="noreferrer">BisQue UCSB repository</a>
        <a href={sourceLinks.ultraRepo} target="_blank" rel="noreferrer">BisQue Ultra repository</a>
        <a href={sourceLinks.researchOutreach} target="_blank" rel="noreferrer">
          Research Outreach: reproducible computer vision
        </a>
        <a href={siteConfig.vrlUrl} target="_blank" rel="noreferrer">UCSB Vision Research Lab</a>
      </div>
    </section>
  </div>
</SiteShell>
