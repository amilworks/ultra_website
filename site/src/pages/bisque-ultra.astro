---
// BisQue Ultra is now the site's landing page. This route remains as a permanent
// alias so existing links, bookmarks, and search results keep working.
const baseUrl = import.meta.env.BASE_URL;
const redirectTarget = baseUrl;
const canonicalUrl = Astro.site ? new URL(redirectTarget, Astro.site).toString() : redirectTarget;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${redirectTarget}`} />
    <link rel="canonical" href={canonicalUrl} />
    <title>Redirecting to BisQue Ultra</title>
    <script is:inline>{`window.location.replace(${JSON.stringify(redirectTarget)});`}</script>
  </head>
  <body>
    <p>
      Redirecting to <a href={redirectTarget}>BisQue Ultra</a>.
    </p>
  </body>
</html>
